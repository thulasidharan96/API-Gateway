ENVIRONMENT=development
APP_NAME=API Gateway Platform
APP_VERSION=0.1.0
API_PREFIX=/api
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=2
DATABASE_URL=******postgres:5432/api_gateway
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
TRUSTED_HOSTS=["*"]
REDIS_RATE_LIMIT_PREFIX=ratelimit
